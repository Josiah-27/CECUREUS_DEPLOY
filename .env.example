# Copy to .env.local for local development.
#
# NEVER put secrets here. Every EXPO_PUBLIC_* value is compiled into the app and can be read by anyone
# who downloads it from Google Play. SMS gateway credentials, email/SMTP passwords, database passwords
# and admin tokens belong ONLY on the server (backend-php/.env). `npm run check:secrets` enforces this.
#
# The app talks to exactly one thing: the CecureUs mobile API at EXPO_PUBLIC_API_BASE_URL.
# Sign-up codes (email + SMS) are generated, sent and checked by that server — not by the app.
#
# For EAS builds, set these per environment with `eas env:create` (preview / production);
# EXPO_PUBLIC_APP_ENV and EXPO_PUBLIC_DEMO_MODE are fixed per profile in eas.json.

# Mobile API base URL (HTTPS required outside local development). Built by the backend team:
# see docs/API_CONTRACT.md and the reference implementation in backend-php/.
EXPO_PUBLIC_API_BASE_URL=https://eap.cecureus.com/api/mobile/v1

# Base URL where CMS image filenames (e.g. counsellor photos) are served.
# PENDING backend confirmation — see BACKEND_BLOCKERS.md (B-09).
EXPO_PUBLIC_MEDIA_BASE_URL=https://eap.cecureus.com/uploads

EXPO_PUBLIC_PRIVACY_POLICY_URL=https://cecureus.com/privacy-policy
EXPO_PUBLIC_TERMS_URL=https://cecureus.com/terms

# development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Development only: run the app against a built-in fake backend (no server needed).
# Refused outside development; never set this for EAS builds.
EXPO_PUBLIC_DEMO_MODE=false

# Local PHP backend (backend-php/README.md), from a phone on the same Wi-Fi:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8080/api/mobile/v1
# Android emulator reaches the PC at 10.0.2.2:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/mobile/v1
# Node mock server (npm run mock-api):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/v1
