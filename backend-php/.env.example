# CecureUs mobile API — server settings.
# Copy to backend-php/.env ON THE SERVER and fill in. Never commit .env.
# Everything here is SERVER-SIDE ONLY: the mobile app never sees these values.
# (Comments must be on their own lines.)

# development | staging | production
# "log" SMS/email drivers are refused in production.
APP_ENV=production

# Random secret used to hash OTP codes. Generate with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=change-me

# URL path the API is served under (the app's EXPO_PUBLIC_API_BASE_URL ends with this).
BASE_PATH=/api/mobile/v1

# --- MySQL (the existing CecureUs database) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
# Use a dedicated MySQL user with SELECT/INSERT/UPDATE on the tables listed in README.md — not root.
DB_USER=
DB_PASS=
# Must match the connection charset the existing website uses (often utf8mb4 or latin1).
DB_CHARSET=utf8mb4

# --- Images ---
# Where image file names from the tables are served (HTTPS). Leave the specific ones empty to use MEDIA_BASE_URL.
MEDIA_BASE_URL=https://eap.cecureus.com/uploads
MEDIA_DOCTOR_BASE_URL=
MEDIA_BLOG_BASE_URL=
MEDIA_QUIZ_BASE_URL=

# --- SMS (SMS Integra) ---
# smsintegra | log
SMS_DRIVER=smsintegra
SMSINTEGRA_URL=https://www.smsintegra.com/api/smsapi.aspx
SMSINTEGRA_UID=
SMSINTEGRA_PWD=
SMSINTEGRA_SID=
SMSINTEGRA_ENTITY_ID=
# DLT template for the sign-up code. The text must match the approved template exactly; {otp} = the code.
SMS_OTP_TEMPLATE_ID=
SMS_OTP_MESSAGE=Your CecureUs verification code is {otp}. It is valid for 10 minutes. Do not share this code with anyone.
# DLT template for the "new booking" alert to the CecureUs team. Leave the id empty to skip the alert.
# Placeholders: {name} {counsellor} {date} {time} {mode}
SMS_BOOKING_TEMPLATE_ID=
SMS_BOOKING_MESSAGE=New CecureUs booking: {name} with {counsellor} on {date} at {time} ({mode}).
ADMIN_SMS_MOBILE=+917200500221

# --- Email (sign-up code) ---
# smtp | mail | log    (smtp needs `composer install` for PHPMailer)
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@cecureus.com
MAIL_FROM_NAME=CecureUs
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# --- Accounts ---
# Old password hashes accepted once and upgraded to Argon2id/bcrypt on login: md5 (and, only if confirmed, plain)
LEGACY_PASSWORD_FORMATS=md5
# Value written to employee_list.status when a user deletes their account
DELETED_STATUS=Cancel
# Clear name/email/mobile/etc. on deletion (Google Play data deletion)
ANONYMISE_ON_DELETE=true

# --- Bookings ---
# Slots starting sooner than this are not offered
BOOKING_LEAD_MINUTES=60
# Bookings can be cancelled until this many minutes before the start
CANCEL_CUTOFF_MINUTES=60
# Hours used for counsellors without a doctor_timelist row (24h, IST)
AVAILABILITY_DEFAULT_HOURS=10:00-21:00
# Product decision B-14: may individual (non-corporate) users book?
ALLOW_INDIVIDUAL_BOOKINGS=true

# --- Network ---
# true only behind a reverse proxy/CDN you control (then X-Forwarded-For is trusted for rate limits)
TRUST_PROXY=false
# Log folder (must be writable, outside the web root)
LOG_DIR=
