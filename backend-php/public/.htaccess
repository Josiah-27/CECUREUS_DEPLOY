# Apache: send every /api/mobile/v1/* request to index.php.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # The public URL path of this folder (needed when it is mapped with Alias).
    RewriteBase /api/mobile/v1/

    # Apache + PHP-FPM/CGI drops the Authorization header unless it is copied like this.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve dotfiles (.env etc.) if someone copies them here by mistake.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
